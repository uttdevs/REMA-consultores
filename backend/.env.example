# --- Servidor (base compartida) ---
PORT=8080
# Orígenes del frontend permitidos (separados por coma, ej: Vite en 5173 o LiveServer en 5500)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173,http://127.0.0.1:5173
# Para HTTPS directo desde Go (en producción suele hacerlo el proxy/hosting)
TLS_CERT=
TLS_KEY=

# --- Base de datos (base compartida) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=rema_consultores

# --- Autenticación y Panel Admin (RF-04) ---
# Forzar cookie como Secure si no se detecta TLS directo (true para producción)
COOKIE_SECURE=false
# Administrador inicial si la tabla usuarios está vacía
ADMIN_INITIAL_EMAIL=admin@remaconsultores.com
ADMIN_INITIAL_PASSWORD=Admin1234#

# --- Correo de confirmación (módulo contacto) ---
# Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=REMA Consultores
